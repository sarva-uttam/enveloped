# --- AI generation ---
# Preferred: run `vercel env pull .env.local` after linking the project and
# enabling AI Gateway in the Vercel dashboard — this provisions VERCEL_OIDC_TOKEN
# automatically and no key below is needed.
# Alternative: a static AI Gateway key (works outside Vercel too).
AI_GATEWAY_API_KEY=
# Optional override of the model slug used in src/app/api/generate/route.ts
AI_MODEL=anthropic/claude-sonnet-4.6

# --- Supabase (persistence for invites, guest lists, RSVPs) ---
# See supabase/schema.sql for the schema. Without these set, the app falls
# back to browser localStorage only (links won't resolve cross-device).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- PayPal (payment gate before an invite is publishable) ---
# Sandbox app credentials from https://developer.paypal.com/dashboard/applications
# — the admin's own PayPal account receives all payments (single merchant,
# no marketplace/partner split). Client ID is safe to expose to the browser;
# the secret must never leave the server.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com while testing, https://api-m.paypal.com in production
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# "sandbox" while testing, "live" once you switch to real charges — keep in
# sync with PAYPAL_API_BASE_URL and the credentials above (sandbox app vs
# live app are different Client ID/Secret pairs in the PayPal dashboard).
NEXT_PUBLIC_PAYPAL_ENV=sandbox
