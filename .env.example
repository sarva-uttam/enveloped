# --- AI generation ---
# Preferred: run `vercel env pull .env.local` after linking the project and
# enabling AI Gateway in the Vercel dashboard — this provisions VERCEL_OIDC_TOKEN
# automatically and no key below is needed.
# Alternative: a static AI Gateway key (works outside Vercel too).
AI_GATEWAY_API_KEY=
# Optional override of the model slug used in src/app/api/generate/route.ts
AI_MODEL=anthropic/claude-sonnet-4.6

# --- Supabase (persistence for invites, guest lists, RSVPs, and auth) ---
# See supabase/schema.sql + supabase/migrations/ for the schema. Without
# these set, invite creation/dashboard/auth are unavailable (see
# PROJECT_STATUS.md — this is intentional now that invites require a real
# owner, not a silent fallback to ownerless local storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER-ONLY, never exposed to the browser. From
# Project Settings > API in the Supabase dashboard. Used by
# src/lib/supabase/admin.ts — every write in src/lib/payments.server.ts
# (findPendingPayment, createPaymentRecord, claimPaymentForCapture,
# markPaymentCaptured, markPaymentFailed) AND markInvitePaid in
# storage.server.ts, since the `payments` table has no insert/update
# policy for anon/authenticated at all (service-role-only by design — see
# supabase/migrations/20260901114212_payment_integrity.sql). Do not add a
# NEXT_PUBLIC_ prefix to this.
#
# AS OF THE STAGE 0 REPO/LIVE RECONCILIATION (2026-09-09), this key is NOT
# SET in this machine's .env.local. Confirmed via variable-name-only
# inspection (no value read or printed): supabaseAdminConfigured is false,
# so createPaymentRecord() returns null and POST /api/paypal/orders 502s
# on every attempt — the entire payment path is dead locally without it.
# Restoring this value in .env.local is a local environment fix, not a
# repository change, and is out of Stage 0's scope.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal (payment gate before an invite is publishable) ---
# Sandbox app credentials from https://developer.paypal.com/dashboard/applications
# — the admin's own PayPal account receives all payments (single merchant,
# no marketplace/partner split). Client ID is safe to expose to the browser;
# the secret must never leave the server.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com while testing, https://api-m.paypal.com in production
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# "sandbox" while testing, "live" once you switch to real charges — keep in
# sync with PAYPAL_API_BASE_URL and the credentials above (sandbox app vs
# live app are different Client ID/Secret pairs in the PayPal dashboard).
NEXT_PUBLIC_PAYPAL_ENV=sandbox
# Optional but recommended: the email address on the PayPal (sandbox or
# live) account that should receive every payment. When set, the capture
# route (src/app/api/paypal/orders/[orderId]/capture/route.ts) verifies
# purchase_units[0].payee.email_address on every capture response matches
# this exactly, rejecting the capture otherwise. Left unset, this one check
# is skipped (all other verification — order id, custom_id, currency, exact
# amount, capture status — still applies unconditionally).
PAYPAL_MERCHANT_EMAIL=
