# --- AI generation ---
# Preferred: run `vercel env pull .env.local` after linking the project and
# enabling AI Gateway in the Vercel dashboard — this provisions VERCEL_OIDC_TOKEN
# automatically and no key below is needed.
# Alternative: a static AI Gateway key (works outside Vercel too).
AI_GATEWAY_API_KEY=
# Optional override of the model slug used in src/app/api/generate/route.ts
AI_MODEL=anthropic/claude-sonnet-4.6

# --- Supabase (persistence for invites, guest lists, RSVPs) ---
# See supabase/schema.sql for the schema. Without these set, the app falls
# back to browser localStorage only (links won't resolve cross-device).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
